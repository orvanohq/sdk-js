{
  "name": "@orvano/client",
  "version": "0.0.0",
  "description": "The Orvano client SDK for browsers and React Native.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orvanohq/sdk-js.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "conformance": "vitest run --project conformance-node --project conformance-hermes --project conformance-browser"
  },
  "engines": {
    "node": ">=22.12"
  }
}
